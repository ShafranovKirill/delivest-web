{
  "name": "delivest-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "schema:download": "curl \"http://localhost:4000/api/openapi\" -o ./src/api/docs/swagger.json",
    "schema:generate": "openapi-typescript ./src/api/docs/swagger.json --output ./src/api/types.ts",
    "schema:sync": "pnpm run schema:download && pnpm run schema:generate"
  },
  "dependencies": {
    "@primeuix/themes": "^3.0.0",
    "@tanstack/vue-query": "^5.102.8",
    "@vueuse/components": "^14.4.0",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primeicons": "^8.0.0",
    "primevue": "^5.0.1",
    "vue": "^3.5.41",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.80.0",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.80.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  }
}
